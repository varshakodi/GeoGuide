DB_PATH=data-model/seed/PS-13.db
CHROMA_PATH=.chroma
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RELEVANCE_THRESHOLD=0.30
TOP_K=6
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_API_KEY_2=optional-second-key
GEMINI_MODEL=model-name-from-ai-studio
OLLAMA_URL=http://localhost:11434/api/chat
GROUNDING_ENABLED=true
DEMO_DATE=
OLLAMA_MODEL=
MAX_SENTENCES=3
# Live requests fail fast to the cited extractive fallback; raise these for prewarm runs.
LLM_TIMEOUT_MS=30000
LLM_QUOTA_ROUNDS=2
LLM_QUOTA_WAIT=5
# Frontend only: set in the shell or frontend/.env.local (Vite does not read this file). Defaults to http://<page host>:8000
VITE_API=
